meta:
  id: wii_text_manifests
  title: Text manifests for Planet-G / Eko Software engines
  endian: be
doc: |
  Manifest output for formats whose lib-*.c decoders were reachable only through
  FILETYPE: Planet-G (.MWG/.MSP/.PKI/.pgf/.MWT), Eko Software (.rck/.spa/...).
  See planetg.ksy-style definitions in this repository for the byte layouts.
seq:
  - id: data
    size-eos: true
